# Variables de entorno — Skilly (LOCAL & RENDER)
# ⚠️  NUNCA subas archivos con contraseñas o tokens reales a Git.

# ─── Django Core ───────────────────────────────────────
# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=cambia-esto-por-una-clave-secreta-real-en-produccion

# En producción: False. Para desarrollo local: True
DEBUG=True

# Hosts permitidos separados por coma.
ALLOWED_HOSTS=localhost,127.0.0.1,skilly.onrender.com

# ─── Base de datos ──────────────────────────────────────
# En Render: se configura automáticamente desde render.yaml con DATABASE_URL
# Para local: dejar vacío (settings.py usa SQLite db.sqlite3)
DATABASE_URL=

# ─── Seguridad del Admin ────────────────────────────────
# URL SECRETA del Django Admin.
ADMIN_URL_PATH=django-admin/

# IPs autorizadas para acceder al Admin/Back-Office en producción.
# Separadas por coma: ADMIN_ALLOWED_IPS=1.2.3.4,5.6.7.8
ADMIN_ALLOWED_IPS=

# ─── Pasarela Transbank Webpay Plus ─────────────────────
# Valores permitidos para TRANSBANK_ENVIRONMENT: TEST (Sandbox) o LIVE (Producción)
TRANSBANK_ENVIRONMENT=TEST

# Solo necesarios si TRANSBANK_ENVIRONMENT=LIVE:
TRANSBANK_COMMERCE_CODE=
TRANSBANK_API_KEY=

